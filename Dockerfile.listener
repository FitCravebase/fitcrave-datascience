FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies (kept in sync with main Dockerfile)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the rest of the application code
COPY . .

# The listener uses FIREBASE_CREDENTIALS_PATH from environment
# and connects to Firestore; no ports need to be exposed.

# Start the HTTP wrapper which runs the Firestore listener in the background
CMD ["sh", "-c", "uvicorn app.orchestrator.listener_service:app --host 0.0.0.0 --port ${PORT:-8080}"]

